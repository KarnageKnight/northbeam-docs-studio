POSTGRES_DB=northbeam
POSTGRES_USER=northbeam
POSTGRES_PASSWORD=northbeam_local

# Optional Docker app override; URL-encode reserved credential characters.
# APP_DATABASE_URL=postgresql://northbeam:northbeam_local@db:5432/northbeam

# For a separately installed host PostgreSQL instance.
# DATABASE_URL=postgresql://northbeam:northbeam_local@127.0.0.1:5432/northbeam
